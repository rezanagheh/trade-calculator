from http.server import BaseHTTPRequestHandler
from urllib.request import Request, urlopen
import json


LBANK_URL = (
    "https://lbkperp.lbank.com/"
    "cfd/openApi/v1/pub/marketData?productGroup=SwapU"
)


class handler(BaseHTTPRequestHandler):

    def do_GET(self):
        try:
            request = Request(
                LBANK_URL,
                headers={
                    "User-Agent": "Mozilla/5.0",
                    "Accept": "application/json",
                }
            )

            with urlopen(request, timeout=15) as response:
                raw_body = response.read()

            data = json.loads(raw_body.decode("utf-8"))

            # LBank response can have different nesting
            raw = data.get("data", data)

            if isinstance(raw, dict):
                raw = (
                    raw.get("list")
                    or raw.get("data")
                    or raw.get("rows")
                    or []
                )

            if not isinstance(raw, list):
                raw = []

            markets = []

            for item in raw:
                if not isinstance(item, dict):
                    continue

                symbol = (
                    item.get("symbol")
                    or item.get("symbolName")
                    or ""
                )

                symbol = str(symbol).upper().strip()

                if not symbol:
                    continue

                last_price = (
                    item.get("lastPrice")
                    or item.get("price")
                    or item.get("close")
                )

                marked_price = item.get("markedPrice")

                markets.append({
                    "symbol": symbol,
                    "lastPrice": last_price,
                    "markedPrice": marked_price
                })

            self.send_response(200)

            self.send_header(
                "Content-Type",
                "application/json; charset=utf-8"
            )

            self.send_header(
                "Cache-Control",
                "no-store, no-cache, must-revalidate"
            )

            self.send_header(
                "Access-Control-Allow-Origin",
                "*"
            )

            self.end_headers()

            self.wfile.write(
                json.dumps(
                    markets,
                    ensure_ascii=False
                ).encode("utf-8")
            )

        except Exception as error:

            payload = {
                "error": str(error),
                "markets": []
            }

            self.send_response(500)

            self.send_header(
                "Content-Type",
                "application/json; charset=utf-8"
            )

            self.send_header(
                "Access-Control-Allow-Origin",
                "*"
            )

            self.end_headers()

            self.wfile.write(
                json.dumps(
                    payload,
                    ensure_ascii=False
                ).encode("utf-8")
            )
